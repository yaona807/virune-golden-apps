{
  "name": "@virune-golden/runtime-shapes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./types/node.d.ts",
        "import": "./runtime/node.mjs"
      },
      "default": {
        "types": "./types/default.d.ts",
        "default": "./runtime/default.mjs"
      }
    },
    "./feature": {
