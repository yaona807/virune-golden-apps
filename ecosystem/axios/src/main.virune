import js axios from "axios"

pub async fn runAxiosEcosystem() -> String uses JavaScript {
	let client = axios.create({
		baseURL: "http://example.com/api",
	})
	let uri = client.getUri({
		url: "/users",
	})
	let response = await client.get("data:text/plain,safe", {
		responseType: "text",
	})
	return "ecosystem:axios:{uri}:{response.status}"
}

pub async fn main() -> Unit uses JavaScript, Console {
	Console.print(await runAxiosEcosystem())
	return Unit
}
