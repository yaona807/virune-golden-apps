import js * as React from "react"
import js { MemoryRouter, useLocation, useNavigate } from "react-router"
import js useAsync from "use-async"

type Cleanup = fn() -> Unit uses Console

fn cleanupEffect() -> Unit uses Console {
	Console.print("golden:react:cleanup")
	return Unit
}

fn installEffect() -> Cleanup uses Console {
	Console.print("golden:react:effect")
	return cleanupEffect
}

internal component EffectProbe() uses JavaScript, Console {
	discard React.useEffect(installEffect)
	return view {
		span(className: "effect-probe") {
			"effect"
		}
	}
}

internal component RouteProbe() uses JavaScript {
	let location = useLocation()
	let navigate = useNavigate()
	return view {
		section(className: "route-probe") {
			p(className: "route-path") {
				{ location.pathname }
			}
			button(id: "navigate", onClick: fn() -> Unit uses JavaScript {
				discard navigate("/next")
				return Unit
			}) {
				"next"
			}
		}
	}
}

internal component RouterApp() uses JavaScript {
	return view {
		MemoryRouter() {
			RouteProbe()
		}
	}
}


async fn loadQuerySuccess() -> String uses Task {
	await Task.sleep(Duration.milliseconds(40))
	return "query:loaded"
}

async fn loadQueryFailure() -> String uses Task {
	await Task.sleep(Duration.milliseconds(40))
	panic("intentional use-async query failure")
}

internal component QueryProbe() uses JavaScript, Task {
	let success = useAsync(loadQuerySuccess)
	let failure = useAsync(loadQueryFailure)
	let successLoading: Bool = success.loading
	let failureLoading: Bool = failure.loading
	return view {
		section(className: "query-probe") {
			if successLoading {
				p(id: "query-success-pending") {
					"loading"
				}
			}
			if !successLoading {
				let successData: String = success.data
				p(id: "query-success-result", "data-value": successData) {
					"success"
				}
			}
			if failureLoading {
				p(id: "query-failure-pending") {
					"loading"
				}
			}
			if !failureLoading {
				p(id: "query-failure-error", "data-error": failure.error) {
					"failure"
				}
			}
		}
	}
}

internal component App(title: String, ready: Bool) uses JavaScript {
	return view {
		main(className: "page", "data-kind": "react") {
			h1() {
				{ title }
			}
			EffectProbe()
			if ready {
				p(className: "status") {
					"ready"
				}
			}
		}
	}
}
