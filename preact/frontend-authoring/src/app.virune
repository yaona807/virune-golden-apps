import js { Suspense } from "preact/compat"
import js { useEffect } from "preact/hooks"

@repetitionHost("render", 1)
extern js "virune-media-jobs-preact-golden/repetition-host" {}

type Cleanup = fn() -> Unit uses Console

fn handle() -> Bool {
	return true
}

fn cleanupEffect() -> Unit uses Console {
	Console.print("golden:cleanup")
}

fn installEffect() -> Cleanup uses Console {
	Console.print("golden:effect")
	return cleanupEffect
}

internal component EffectProbe() uses JavaScript, Console {
	discard useEffect(installEffect)
	return view {
		span(class: "effect-probe") {
			"effect"
		}
	}
}

internal component Panel(title: String) uses JavaScript {
	return view {
		section(class: "panel") {
			h2() {
				{ title }
			}
			children
		}
	}
}

internal component DuplicateIdentityProbe() uses JavaScript {
	return view {
		ul() {
			for item in ["duplicate", "duplicate"] by item {
				li() {
					{ item }
				}
			}
		}
	}
}

internal component App(title: String, ready: Bool) uses JavaScript {
	return view {
		main(class: "page", "data-kind": "jobs") {
			h1() {
				{ title }
			}
			button(onClick: handle) {
				"Run"
			}
			EffectProbe()
			Suspense(fallback: "Loading") {
				p(class: "suspense-content") {
					"Loaded"
				}
			}
			if ready {
				p(class: "status") {
					"ready"
				}
			}
			Panel(title: "Queue") {
				ul() {
					for item, index in ["compile", "ship"] by item {
						li("data-index": index) {
							{ item }
						}
					}
				}
			}
		}
	}
}
